{
  "name": "customer-inquiry-management",
  "version": "1.0.0",
  "private": true,
  "description": "Customer Inquiry Management System - Project Foundation",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build:frontend": "npm --prefix frontend run build",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:test": "npm --prefix backend run db:test",
    "db:seed": "npm --prefix backend run db:seed",
    "db:setup": "npm --prefix backend run db:setup",
    "db:clear-sessions": "npm --prefix backend run db:clear-sessions",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test": "npm run test:backend && npm run test:frontend"
  }
}
