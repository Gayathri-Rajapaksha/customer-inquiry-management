# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
# Option 1: Full connection URI (optional)
# DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/customer_inquiry_db

# Option 2: Standard individual PostgreSQL parameters
PGHOST=localhost
PGPORT=5432
PGDATABASE=customer_inquiry_db
PGUSER=postgres
PGPASSWORD=your_db_password_here

# Session Configuration
SESSION_SECRET=your_secure_session_secret_change_in_production

# Initial Staff User Seed Configuration (Optional overrides)
SEED_STAFF_EMAIL=admin@coffeeninja.com
SEED_STAFF_PASSWORD=your_initial_staff_password_here
